#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>

/* macOS F-row 전용 커스텀 consumer usage (ZMK 코어 keys.h에 없어 직접 정의):
   - C_MISSION_CONTROL: Consumer Page(0x0C) usage 0x29F. 공식 USB HID Usage
     Tables엔 없지만 QMK가 코어 키코드로 채택했고(KC_MISSION_CONTROL, PR #19884)
     macOS가 실제로 인식하는 값.
   - C_DICTATION: Consumer Page(0x0C) usage 0xD8. 공식 USB HID Usage Tables
     HUTRR99 "Start or Stop Voice Dictation Session" 표준 usage.
   F4(Spotlight)는 전용 HID usage가 불확실해 Cmd+Space 매크로(&spotlight_macro,
   아래 behaviors 참고)로 대체. F6(방해금지모드)은 실제 macOS가 보내는 코드가
   ZMK가 지원하지 않는 Generic Desktop 페이지(usage 0x9B)라 순정 방식 구현 불가 -
   확인 후 빈 키로 유지. */
#define C_MISSION_CONTROL ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x29F)
#define C_DICTATION       ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0xD8)

/ {
    behaviors {
        /* 한/영 오타 자동 되돌리기 트리거. 파라미터: 0=Windows(Ctrl+Backspace),
           1=macOS(Option+Backspace). 실제 구현은 config/src/ksn2_word_flip.c 참고. */
        word_flip: word_flip {
            compatible = "ksn,behavior-word-flip";
            #binding-cells = <1>;
        };

        vol_encoder: vol_encoder {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tap-ms = <40>;
        };

        inc_dec_bl: inc_dec_bl {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bl BL_INC>, <&bl BL_DEC>;
        };

        /* macOS Spotlight 검색 실행 매크로 (Cmd+Space). F4 자리 전용(mac_layer) -
           2020년 이후 최신 맥 F4가 여는 것과 동일한 화면(Spotlight)을 염. */
        spotlight_macro: spotlight_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_wait_time 100>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LGUI>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * KSN2 Matrix: 6 rows x 18 cols
         *   Left  half: col 0..8  (central, encoder = encoder_left)
         *   Right half: col 9..17 (peripheral, no encoder)
         *
         * sensor-bindings order: <left_sensor>
         *   default_layer : left encoder = volume
         *   func_layer    : left encoder = backlight
         *   mac_layer     : left encoder = volume
         *
         * -- LEFT half (col 0..8) -------------------------------------------
         *  R0:  PAUSE ESC   F1    F2    F3    F4    F5    F6    —
         *  R1:  BSPC  `     1     2     3     4     5     6     —
         *  R2:  DEL   TAB   —     Q     W     E     R     T     Y
         *  R3:  MAC3  CAPS  —     A     S     D     F     G     H     (Windows: Win+L / Mac: Cmd+Ctrl+Q — both lock screen; func_layer: toggles Mac layer)
         *  R4:  MAC1  LSHFT —     Z     X     C     V     B     —     (Windows: Ctrl+Alt+Del / Mac: Cmd+Opt+Esc)
         *  R5:  MAC2  MO1   LCTRL LGUI  LALT  —     SPC   —     —     (Windows: Win+Shift+S / Mac: Cmd+Shift+4)
         *
         * -- RIGHT half (col 9..17) -----------------------------------------
         *  R0:  F7    F8    F9    F10   F11   F12   INS   DEL   HOME
         *  R1:  7     8     9     0     -     =     —     BSPC  END
         *  R2:  Y     U     I     O     P     [     ]     \     PGUP
         *  R3:  H     J     K     L     ;     '     —     RET   PGDN
         *  R4:  B     N     M     ,     .     /     LSHFT UP    K_APP
         *  R5:  —     SPC   LANG1 word_flip MO1   LANG2 LEFT  DOWN  RIGHT
         *
         * Notes:
         *  - RC(row, 0..8)  = left half cols
         *  - RC(row, 9..17) = right half cols
         *  - mac1, mac2, and mac3 are system shortcut keys.
         *  - col 8 on left (RC(x,8)) is &none - hardware not wired
         *  - 2026-09-05: RALT(우측 col12) -> LANG1(한/영). KSN-1과 동일한
         *    표준 HID usage(0x90) - Win10 1809+/macOS에서 동작, "PC/AT 101키
         *    호환 키보드(종류 1)" 드라이버에서는 인식 안 될 수 있음(ksn1-firmware
         *    참고). default_layer/mac_layer 둘 다 동일하게 적용.
         *  - 2026-09-06: RGUI(우측 col13, Win) -> word_flip(한/영 오타
         *    자동 되돌리기 트리거). default_layer=&word_flip 0(Windows),
         *    mac_layer=&word_flip 1(macOS). 구현은 config/src/ksn2_word_flip.c
         *    참고. 오른쪽 Win/Cmd는 완전히 사라짐 - 왼쪽 col3(LGUI)만 남음.
         *    한자(LANG2)는 이번엔 요청 없어서 추가 안 함; RCTRL(col14)은
         *    그대로 유지.
         *  - 2026-09-06 (v2): 사용자 요청으로 col11(mo 1/FN)과 col13
         *    (word_flip)의 자리를 서로 바꿈. col12(LANG1)는 그대로 가운데에
         *    있고, 이제 col11=&word_flip, col13=&mo 2.
         *  - 2026-09-06 (v3): 사용자 요청으로 스페이스바 우측을
         *    "한/영 - 단어되돌리기 - FN - 한자" 순서로 재배치.
         *    col11=한/영, col12=&word_flip, col13=&mo 2, col14=한자.
         *    OS별로 다른 키코드를 쓰는 두 자리:
         *      col11 한/영  - default_layer=&kp LANG1, mac_layer=&kp CLCK
         *        (macOS는 LANG1을 일본어 JIS 가나 키로 해석해 한/영 전환이
         *         안 됨. Caps Lock은 시스템 설정의 "Caps Lock 키로 ABC 입력
         *         소스 전환"이 켜져 있을 때 짧게 누르면 한/영, 길게 누르면
         *         실제 Caps Lock으로 동작.)
         *      col14 한자   - default_layer=&kp LANG2, mac_layer=&kp LA(RET)
         *        (macOS의 한자 변환은 Option+Return. LANG2는 macOS에서
         *         동작하지 않음.)
         *    주의: 이 변경으로 오른쪽 RCTRL이 사라짐 - Ctrl은 왼쪽
         *    col2(LCTRL)만 남음. 오른쪽 Win/Cmd는 v1에서 이미 사라졌음.
         *  - 2026-09-18: 사용자 요청으로 default_layer 왼쪽 col0의 Pause 아래 매크로키
         *    5개(R1~R5, 기존 Win+L / Win+D / Ctrl+S / Ctrl+C / Ctrl+V)를 F13~F17로
         *    변경(R1=F13, R2=F14, R3=F15, R4=F16, R5=F17). KSN-2만 해당 - KSN-1/KSN-3은
         *    변경하지 않음. mac_layer의 같은 자리(Cmd+Ctrl+Q 잠금/Cmd+Opt+Esc 강제종료/
         *    Cmd+Shift+4 스크린샷)는 그대로 유지됨(func_layer는 &trans라 영향 없음).
         *  - 2026-09-22: 사용자 요청으로 mac_layer 왼쪽 col0의 R1~R5도 동일하게
         *    F13~F17로 변경(R1=F13, R2=F14, R3=F15, R4=F16, R5=F17). 기존 BSPC/DEL
         *    (R1/R2)과 Cmd+Ctrl+Q 잠금/Cmd+Opt+Esc 강제종료/Cmd+Shift+4 스크린샷
         *    (R3~R5)을 모두 대체함 - BSPC/DEL은 오른쪽 col16(R1)/R0 col16(DEL)에
         *    이미 있어 완전히 없어지지는 않음. default_layer와 동일한 레이아웃이 됨.
         */

        default_layer {
            /* left encoder: volume */
            sensor-bindings = <&vol_encoder C_VOL_UP C_VOL_DN>;
            bindings = <
/* LEFT col0..8 */                                                                                /* RIGHT col9..17 */
/* R0 */ &kp PAUSE_BREAK &kp ESC        &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &none      &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp INS   &kp DEL   &kp HOME
/* R1 */ &kp F13         &kp GRAVE      &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &none      &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &none     &kp BSPC  &kp END
/* R2 */ &kp F14         &kp TAB        &none     &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y      &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH  &kp PG_UP
/* R3 */ &kp F15         &kp CLCK       &none     &kp A     &kp S     &kp D     &kp F     &kp G     &kp H      &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &none     &kp RET   &kp PG_DN
/* R4 */ &kp F16         &kp LSHFT      &none     &kp Z     &kp X     &kp C     &kp V     &kp B     &none      &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP    &kp K_APP
/* R5 */ &kp F17         &mo 2          &kp LCTRL &kp LGUI  &kp LALT  &none     &kp SPACE &none     &none      &none     &kp SPACE &kp LANG1        &word_flip 0 &mo 2 &kp LANG2 &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        mac_layer {
            /* left encoder: volume */
            sensor-bindings = <&vol_encoder C_VOL_UP C_VOL_DN>;
            bindings = <
/* R0 */ &kp PAUSE_BREAK &kp ESC        &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &kp C_MISSION_CONTROL &spotlight_macro &kp C_DICTATION &none     &none      &kp C_PREV &kp C_PP  &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp INS   &kp DEL   &kp HOME
/* R1 */ &kp F13         &kp GRAVE      &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &none      &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &none     &kp BSPC  &kp END
/* R2 */ &kp F14         &kp TAB        &none     &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y      &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH  &kp PG_UP
/* R3 */ &kp F15         &kp CLCK       &none     &kp A     &kp S     &kp D     &kp F     &kp G     &kp H      &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &none     &kp RET   &kp PG_DN
/* R4 */ &kp F16         &kp LSHFT      &none     &kp Z     &kp X     &kp C     &kp V     &kp B     &none      &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp LSHFT &kp UP    &trans   
/* R5 */ &kp F17         &mo 2          &kp LCTRL &kp LALT  &kp LGUI  &none     &kp SPACE &none     &none      &none     &kp SPACE &kp CLCK         &word_flip 1 &mo 2 &kp LA(RET) &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        /* 레이어 순서: default(0) → mac(1) → func(2).
           func_layer를 맨 위에 두어 FN(&mo 2)을 누르면 Windows/Mac 모드와 관계없이 항상 이 레이어가
           우선한다(ZMK는 켜진 레이어 중 번호가 높은 것부터 확인). &trans 자리는 아래 레이어로 통과하므로
           FN 없이 누른 키는 그대로 mac_layer/default_layer 동작을 한다. Mac 모드 전환은 &tog 1. */
        func_layer {
            /* left encoder: backlight */
            sensor-bindings = <&inc_dec_bl>;
            bindings = <
/* R0 */ &trans     &trans    &trans       &trans       &trans       &trans       &trans       &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans          &bt BT_CLR
/* R1 */ &trans     &trans    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_TOG &trans  &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans          &trans
/* R2 */ &trans     &trans    &trans       &trans       &trans       &trans       &trans       &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans          &trans
/* R3 */ &trans     &trans    &trans       &trans       &trans       &trans       &trans       &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans          &trans
/* R4 */ &trans     &trans    &trans       &trans       &trans       &trans       &trans       &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans          &tog 1
/* R5 */ &trans     &trans    &trans       &trans       &trans       &trans       &trans       &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans          &trans
            >;
        };
    };
};
